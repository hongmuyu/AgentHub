# ============================================================================
# LLM Provider Configuration
# ============================================================================
# BASE_URL and API_KEY are the standard configurations for model call authentication.
# These variables support OpenAI, Gemini, LM Studio, Ollama, and other providers.

BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-openai-api-key-here
# Required by the six AgentHub demo workflows; choose a model supported by BASE_URL.
# MODEL_NAME=your-chat-model

# Example BASE_URL values:
# - OpenAI:    https://api.openai.com/v1
# - Gemini:    https://generativelanguage.googleapis.com
# - LM Studio: http://localhost:1234/v1
# - Ollama:    http://localhost:11434/v1

# Optional AgentHub embeddings endpoint; independent of chat BASE_URL/API_KEY.
# AGENTHUB_EMBEDDING_BASE_URL=https://embedding.example/v1
# AGENTHUB_EMBEDDING_MODEL=your-embedding-model
# AGENTHUB_EMBEDDING_MODEL_KEY=your-vector-space-version
# AGENTHUB_EMBEDDING_DIMENSIONS=your-model-dimensions
# AGENTHUB_EMBEDDING_API_KEY_ENV=YOUR_EMBEDDING_KEY_ENV_NAME
# Set the named credential environment variable outside this file.

# ============================================================================
# Optional: Web Search and Reading Tools
# ============================================================================

# SERPER_DEV_API_KEY=your-serper-api-key-here
# Get from: https://serper.dev

# JINA_API_KEY=your-jina-api-key-here
# Get from: https://jina.ai
